APP_NAME="Collective Football"
APP_ENV=testing
APP_KEY=base64:PLACEHOLDER_CI_KEY_WILL_BE_GENERATED
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=collective_football_test
DB_USERNAME=collective
DB_PASSWORD=collective_secret

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=localhost
REDIS_PORT=6379

OCTANE_SERVER=swoole
