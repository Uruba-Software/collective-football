APP_NAME="Collective Football"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://collective.docker

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL 16 + PostGIS) ──────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=collective_football
DB_USERNAME=collective
DB_PASSWORD=collective_secret

# ─── Cache & Sessions (Redis) ─────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# ─── Queue (RabbitMQ primary, Redis fallback) ─────────────────────────────────
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=collective
RABBITMQ_PASSWORD=collective_secret
RABBITMQ_VHOST=collective_football

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── WebSocket (Laravel Reverb) ───────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=collective-football
REVERB_APP_KEY=collective-reverb-key
REVERB_APP_SECRET=collective-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="collective.docker"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Elasticsearch 8 ─────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=http://elasticsearch:9200

# ─── Error Tracking (GlitchTip / Sentry) ──────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─── Laravel Octane (Swoole — High Traffic Mode) ─────────────────────────────
OCTANE_SERVER=swoole
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=2
OCTANE_MAX_REQUESTS=500

# ─── AI Provider (Laravel Prism — Multi-provider) ─────────────────────────────
# Provider: openai | anthropic | ollama
# Şimdi: openai (ChatGPT Pro)
# Phase 4+: ollama (GPU server, Redmine #199)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# Anthropic (opsiyonel — premium kullanım için)
ANTHROPIC_API_KEY=

# Ollama — Self-hosted GPU server (Phase 4, Redmine #199)
# OLLAMA_BASE_URL=http://gpu-server-ip:11434
# OLLAMA_MODEL=qwen2.5:7b

# Per use-case override (boş bırakılırsa AI_PROVIDER/AI_MODEL kullanılır)
# AI_MATCH_EVENTS_PROVIDER=
# AI_MATCH_EVENTS_MODEL=
# AI_NEWS_PROVIDER=
# AI_NEWS_MODEL=
# AI_PSYCHOLOGY_PROVIDER=
# AI_PSYCHOLOGY_MODEL=
# AI_CORPUS_PROVIDER=
# AI_CORPUS_MODEL=
# AI_SCANDAL_PROVIDER=
# AI_SCANDAL_MODEL=

# ─── External APIs (Phase 2+) ─────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
TRANSFERMARKT_ENABLED=false
FBREF_ENABLED=false

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@collective.football"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
